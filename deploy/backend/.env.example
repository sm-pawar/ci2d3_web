# ==============================================================================
# Extra environment variables for the BACKEND stack (geo.wirl.carleton.ca)
# after adding the ci2d3-postgis + flask-api services. Merge these into the
# backend .env.
# ==============================================================================

# Password for the NEW dedicated CI2D3 PostGIS container (you own this DB).
# Used by both the Flask API and the GeoServer datastore. Any strong string.
#   e.g.  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
CI2D3_DB_PASSWORD=change-me-to-a-strong-password

# Flask session secret. Any long random string.
#   e.g.  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string
