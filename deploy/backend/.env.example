# ==============================================================================
# Extra environment variables for the BACKEND stack (geo.wirl.carleton.ca)
# after adding the flask-api service. Merge these into the backend .env.
# ==============================================================================

# Existing - the PostGIS password already used by the backend compose.
# The flask-api service reads it for its DB connection.
POSTGRES_PASSWD=change-me

# New - Flask session secret. Any long random string.
#   e.g.  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string
