# Docker ignore file for CI2D3 Ice Island Explorer
# Excludes files and directories from Docker build context

# Git
.git
.gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
venv/
env/
.venv

# Backend (not needed for GeoServer image)
backend/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Documentation (not needed in image)
*.md
!README.md

# Environment files
.env
.env.local
.env.*

# Logs
logs/
*.log

# Temporary files
tmp/
temp/

# Old files
old_docker/

# Build artifacts
dist/
build/
