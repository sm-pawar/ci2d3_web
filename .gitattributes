# CI2D3 Git Attributes
# Ensures consistent line endings across platforms

# Auto detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell scripts must always use LF (Unix) line endings
*.sh text eol=lf

# Docker-related files
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf

# Configuration files
*.conf text eol=lf
*.config text eol=lf
*.env text eol=lf

# Web files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf

# Python files
*.py text eol=lf

# Markdown files
*.md text eol=lf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.shp binary
*.shx binary
*.dbf binary
*.prj binary
*.qix binary
