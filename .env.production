# CI2D3 Ice Island Explorer - Production Environment Configuration for AWS EC2
#
# IMPORTANT: Replace <YOUR_EC2_PUBLIC_IP> with your actual EC2 instance public IP address
# Example: PUBLIC_IP=54.123.45.67
#

# ==============================================================================
# AWS EC2 Configuration
# ==============================================================================

# Your EC2 Public IP or Domain Name
# Replace this with your actual public IP address from AWS Console
PUBLIC_IP=<YOUR_EC2_PUBLIC_IP>

# Alternative: Use your custom domain if you have one
# PUBLIC_DOMAIN=iceislands.yourdomain.com

# ==============================================================================
# Database Configuration
# ==============================================================================

DB_HOST=postgis
DB_PORT=5432
DB_NAME=ci2d3_db
DB_USER=geoserver
DB_PASSWORD=geoserver123

# SECURITY: Change these passwords in production!
# Use strong passwords for production deployment

# ==============================================================================
# GeoServer Configuration
# ==============================================================================

GEOSERVER_URL=http://${PUBLIC_IP}:8080/geoserver
GEOSERVER_WORKSPACE=ci2d3
GEOSERVER_LAYER=iceislands
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=geoserver

# SECURITY: Change admin password!

# ==============================================================================
# Flask API Configuration
# ==============================================================================

FLASK_APP=app.py
FLASK_ENV=production
SECRET_KEY=CHANGE-THIS-TO-A-RANDOM-SECRET-KEY-IN-PRODUCTION

# ==============================================================================
# CORS Configuration
# ==============================================================================

# For production, specify allowed origins explicitly
# Use * for testing, but restrict in production for security
CORS_ORIGINS=*

# For better security in production, use specific origins:
# CORS_ORIGINS=http://${PUBLIC_IP}:8080,http://${PUBLIC_IP}:5000

# ==============================================================================
# Application Settings
# ==============================================================================

ITEMS_PER_PAGE=100
MAX_ITEMS=1000

# ==============================================================================
# AWS EC2 Security Group Ports
# ==============================================================================
# Make sure these ports are open in your AWS EC2 Security Group:
#   - 8080 (GeoServer & Frontend)
#   - 5000 (Flask API)
#   - 22   (SSH - for management)
#
# Optional (if you need direct database access):
#   - 5432 (PostgreSQL - NOT recommended for production)
# ==============================================================================
